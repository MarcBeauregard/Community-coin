{
  "name": "community-coin",
  "version": "0.1.0",
  "private": true,
  "description": "A memecoin launchpad where every copy feeds the original: no snipers, no duplicate tickers, rival memes can merge.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node web/build.mjs",
    "build:lobbies": "node web/lobbies/build.mjs",
    "serve:lobbies": "node web/lobbies/server/server.mjs --guests",
    "index:lobbies": "node web/lobbies/indexer.mjs",
    "simulate:web": "node web/simulate.mjs --json",
    "test": "npm run test:solana && npm run test:protocol && npm run test:wire && npm run build:web && node web/simulate.mjs && npm run test:web && npm run test:wallet && npm run test:lobbies",
    "test:solana": "cd solana && cargo test",
    "test:protocol": "node web/protocol-check.mjs",
    "test:wire": "node web/wire-check.mjs",
    "test:web": "node web/e2e.cjs",
    "test:wallet": "node web/e2e-wallet.mjs",
    "test:lobbies": "node web/lobbies/check.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "htm": "^3.1.1",
    "livekit-client": "2.15.0",
    "playwright": "1.63.0",
    "preact": "^10.29.8"
  }
}
