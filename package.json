{
  "name": "community-coin",
  "version": "0.1.0",
  "private": true,
  "description": "A memecoin launchpad where every copy feeds the original: no snipers, no duplicate tickers, rival memes can merge.",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "simulate": "hardhat run scripts/simulate.js",
    "simulate:web": "SIM_JSON=web/src/simulation.json hardhat run scripts/simulate.js",
    "build:web": "hardhat compile && node web/build.mjs",
    "test:web": "node web/e2e.cjs",
    "deploy": "hardhat run scripts/deploy.js --network target",
    "test:wallet": "node web/e2e-wallet.cjs",
    "test:curve": "node web/curve-check.mjs"
  },
  "devDependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.1.0",
    "chai": "4.5.0",
    "esbuild": "^0.25.12",
    "ethers": "6.17.0",
    "hardhat": "2.28.6",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "solc": "0.8.28"
  }
}
